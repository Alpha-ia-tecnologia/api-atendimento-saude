NODE_ENV=development
PORT=3000

# Única fonte da verdade para a conexão com o banco.
# Use o host real do seu Postgres (remoto ou local).
DATABASE_URL=postgresql://usuario:senha@host:5432/atendimento_db?schema=public

# Generate with: openssl rand -hex 64
JWT_SECRET=changeme
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

AUTH_SINGLE_SESSION=true

BCRYPT_SALT_ROUNDS=10

CORS_ORIGIN=http://localhost:3000

# OCR de triagem da foto do encaminhamento (Tesseract, local).
# OCR_HABILITADO=false desliga a verificação (uploads passam sem análise).
OCR_HABILITADO=true
OCR_MAX_TENTATIVAS=3
OCR_CONF_MIN=50
OCR_MIN_CHARS=25
OCR_MIN_PALAVRAS=6

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

# Integrações WhatsApp (tela do CRM — Evolution / Meta Cloud)
# ENCRYPTION_KEY: chave secreta p/ cifrar as credenciais dos provedores em
#   repouso (AES-256-GCM). Defina UMA vez no servidor; nunca versionar o valor
#   real. Sem ela, a tela de Integrações não salva/lê credenciais.
# PUBLIC_BASE_URL: domínio público do backend, usado p/ montar a URL do
#   webhook do WhatsApp exibida no CRM (ex.: https://api.seu-dominio.com).
ENCRYPTION_KEY=
PUBLIC_BASE_URL=

# Opcional: só são usadas se você subir o Postgres local com
# `docker compose --profile local-db up`. Caso esteja usando
# um banco remoto via DATABASE_URL, pode ignorar/remover.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=atendimento_db
