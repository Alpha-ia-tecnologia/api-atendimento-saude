generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================================================================
// ENUMS
// ===================================================================

enum TipoPerfilCrm {
  ADMIN
  SUPERVISOR
  USUARIO
}

enum TipoPerfilMaria {
  ADMIN
  SOLICITANTE
}

enum TipoEspecialidade {
  CONSULTA
  EXAME
  OUTRO
}

/// Pra solicitações de CONSULTA: indica se é a primeira vez do paciente
/// nessa especialidade ou se é um retorno (revisão / acompanhamento).
/// Fica nullable em Solicitacao porque exames não usam.
enum TipoConsulta {
  PRIMEIRA
  RETORNO
}

enum StatusSolicitacao {
  SOLICITADA
  EM_ATENDIMENTO
  AGENDADA
  NAO_APROVADA
  REALIZADA
  CANCELADA
  NAO_COMPARECEU
}

enum TipoAnexo {
  IMAGEM
  DOCUMENTO
  OUTRO
}

/// Indica se a solicitação é pro próprio solicitante ou pra outra pessoa.
/// - EU    : paciente == solicitante (dados do paciente vêm do UsuarioMaria)
/// - OUTRA : paciente != solicitante (dados do paciente vêm do chat)
enum ParaQuem {
  EU
  OUTRA
}

/// Por qual canal a solicitação chegou ao sistema.
enum OrigemSolicitacao {
  APP
  WEB
  WHATSAPP
  CRM
}

enum CanalNotificacao {
  WHATSAPP
  PUSH
  SMS
  EMAIL
}

enum TipoNotificacao {
  SOLICITACAO_CRIADA
  SOLICITACAO_AGENDADA
  SOLICITACAO_NAO_APROVADA
  SOLICITACAO_REALIZADA
  SOLICITACAO_CANCELADA
  OUTRO
}

enum StatusNotificacao {
  PENDENTE
  ENVIADA
  ENTREGUE
  LIDA
  FALHA
}

// ===================================================================
// ATENDIMENTO (conversa conduzida pelo motor de fluxo)
// ===================================================================

/// Canal por onde a conversa entrou.
enum CanalConversa {
  WEB
  APP
  WHATSAPP
}

/// Estado da máquina de estados da conversa.
enum EstadoConversa {
  ABERTA
  EM_ANDAMENTO
  AGUARDANDO_SOLICITANTE
  ENCERRADA
  EXPIRADA
}

enum DirecaoMensagem {
  ENTRADA
  SAIDA
}

/// Quem produziu a mensagem.
enum AutorMensagem {
  SOLICITANTE
  BOT
  GESTOR
}

enum TipoMensagem {
  TEXTO
  IMAGEM
  DOCUMENTO
  OPCAO
  SISTEMA
}

// ===================================================================
// FLUXO DE ATENDIMENTO (versionado — editor de fluxo do CRM)
// ===================================================================

/// Tipo lógico de um fluxo de atendimento.
enum TipoFluxo {
  CONSULTA
  EXAME
  OUTRO
}

/// Tipo de nó (passo) do fluxo. Espelha os tipos interpretados pelo motor.
enum TipoNoFluxo {
  INICIO
  MENSAGEM
  ESCOLHA
  CONDICAO
  ESPECIALIDADES
  PERGUNTA_TEXTO
  UPLOAD
  ACAO_CRIAR_SOLICITACAO
  REDIRECIONAR
  FIM
}

/// Estado de uma versão de fluxo (regra de ouro: publicar é imutável).
enum StatusFluxoVersao {
  RASCUNHO
  PUBLICADA
  ARQUIVADA
}

/// Grafo de canal dentro de uma versão: Web/App e WhatsApp são editados
/// separadamente (podem ser fluxos completamente diferentes).
enum CanalFluxo {
  WEB_APP
  WHATSAPP
}

/// Tipo de uma variável declarada pelo fluxo.
enum TipoVariavelFluxo {
  TEXTO
  CPF
  DATA
  ARQUIVO
  OPCAO
  TELEFONE
}

// ===================================================================
// INTEGRAÇÕES (canais de WhatsApp)
// ===================================================================

/// Provedor de mensageria do WhatsApp.
enum ProvedorCanal {
  EVOLUTION
  META
}

/// Estado da conexão do canal com o provedor.
enum StatusIntegracao {
  DESCONECTADA
  CONECTADA
  ERRO
}

// ===================================================================
// USUÁRIOS
// ===================================================================

model UsuarioCrm {
  id            String        @id @default(uuid()) @db.Uuid
  email         String        @unique
  senhaHash     String        @map("senha_hash")
  nomeCompleto  String        @map("nome_completo")
  tipoPerfil    TipoPerfilCrm @default(USUARIO) @map("tipo_perfil")
  ativo         Boolean       @default(true)
  ultimoLoginEm DateTime?     @map("ultimo_login_em")
  criadoEm      DateTime      @default(now()) @map("criado_em")
  atualizadoEm  DateTime      @updatedAt @map("atualizado_em")
  excluidoEm    DateTime?     @map("excluido_em")

  solicitacoesComoAgente Solicitacao[]  @relation("SolicitacoesAgenteCrm")
  refreshTokens          RefreshToken[]
  auditLogs              AuditLog[]

  @@index([tipoPerfil])
  @@index([ativo])
  @@index([excluidoEm])
  @@map("usuarios_crm")
}

model UsuarioMaria {
  id             String          @id @default(uuid()) @db.Uuid
  nome           String
  cpf            String          @unique @db.VarChar(11)
  dataNascimento DateTime        @map("data_nascimento") @db.Date
  endereco       String?
  numeroWhatsapp String          @map("numero_whatsapp")
  fotoPerfilUrl  String?         @map("foto_perfil_url")
  tipoPerfil     TipoPerfilMaria @default(SOLICITANTE) @map("tipo_perfil")
  ativo          Boolean         @default(true)
  criadoEm       DateTime        @default(now()) @map("criado_em")
  atualizadoEm   DateTime        @updatedAt @map("atualizado_em")

  preferenciasAcessibilidade  PreferenciasAcessibilidade?
  solicitacoesComoSolicitante Solicitacao[]
  anexosEnviados              SolicitacaoAnexo[]
  notificacoes                Notificacao[]
  conversas                   Conversa[]
  deviceTokens                DeviceToken[]

  @@index([tipoPerfil])
  @@index([ativo])
  @@index([numeroWhatsapp])
  @@map("usuarios_maria")
}

model PreferenciasAcessibilidade {
  usuarioMariaId String   @id @map("usuario_maria_id") @db.Uuid
  altoContraste  Boolean  @default(false) @map("alto_contraste")
  escalaFonte    Decimal  @default(1.0) @map("escala_fonte") @db.Decimal(3, 2)
  narracao       Boolean  @default(false)
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  usuarioMaria UsuarioMaria @relation(fields: [usuarioMariaId], references: [id], onDelete: Cascade)

  @@map("preferencias_acessibilidade")
}

// ===================================================================
// CATÁLOGO
// ===================================================================

model UnidadeSaude {
  id           String   @id @default(uuid()) @db.Uuid
  nome         String
  endereco     String?
  bairro       String?
  cidade       String?
  uf           String?  @db.VarChar(2)
  cep          String?  @db.VarChar(8)
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  solicitacoes Solicitacao[]

  @@index([ativo])
  @@map("unidades_saude")
}

model Especialidade {
  id           String            @id @default(uuid()) @db.Uuid
  nome         String            @unique
  tipo         TipoEspecialidade
  /// Descrição curta exibida no chatbot (ex: "Coração e sistema circulatório").
  descricao    String?
  /// Nome do ícone Lucide (ex: "heart", "stethoscope", "droplet"). O front
  /// mapeia esse string pro componente real. Mantém o DB leve e portável.
  icone        String?
  disponivel   Boolean           @default(true)
  ordem        Int               @default(0)
  criadoEm     DateTime          @default(now()) @map("criado_em")
  atualizadoEm DateTime          @updatedAt @map("atualizado_em")

  solicitacoes Solicitacao[]

  @@index([tipo])
  @@index([disponivel])
  @@map("especialidades")
}

// ===================================================================
// SOLICITAÇÃO
// ===================================================================

model Solicitacao {
  id        String @id @default(uuid()) @db.Uuid
  protocolo String @unique

  // -------- Quem criou a solicitação (usuário autenticado) --------
  /// Usuário Maria que enviou o pedido. Nullable pra cobrir pedidos
  /// registrados manualmente pelo CRM sem conta no app.
  solicitanteId String?       @map("solicitante_id") @db.Uuid
  solicitante   UsuarioMaria? @relation(fields: [solicitanteId], references: [id], onDelete: SetNull)

  // -------- Pra quem é a solicitação (paciente) --------
  /// EU: solicitante == paciente. OUTRA: dados vêm do chat.
  paraQuem ParaQuem @default(EU) @map("para_quem")

  /// Snapshot dos dados do paciente no momento da solicitação.
  /// Quando paraQuem=EU, são copiados do UsuarioMaria do solicitante;
  /// quando OUTRA, são preenchidos pelo chat. Manter o snapshot garante
  /// integridade histórica mesmo se o cidadão atualizar o cadastro depois.
  pacienteNome             String    @map("paciente_nome")
  pacienteCpf              String    @map("paciente_cpf") @db.VarChar(11)
  pacienteDataNascimento   DateTime? @map("paciente_data_nascimento") @db.Date
  pacienteEndereco         String?   @map("paciente_endereco")
  pacienteTelefone         String?   @map("paciente_telefone")
  pacienteTelefoneWhatsapp String?   @map("paciente_telefone_whatsapp")

  // -------- Dados clínicos --------
  unidadeSaudeId  String?           @map("unidade_saude_id") @db.Uuid
  especialidadeId String            @map("especialidade_id") @db.Uuid
  tipo            TipoEspecialidade
  /// Só preenchido quando tipo=CONSULTA (PRIMEIRA ou RETORNO). Para EXAME
  /// e OUTRO permanece null.
  tipoConsulta    TipoConsulta?     @map("tipo_consulta")
  status          StatusSolicitacao @default(SOLICITADA)
  /// Por qual canal a solicitação chegou.
  origem          OrigemSolicitacao @default(APP)

  // -------- Agendamento / atendimento (preenchidos pelo CRM) --------
  agenteResponsavelCrmId String?   @map("agente_responsavel_crm_id") @db.Uuid
  motivoNaoAprovacao     String?   @map("motivo_nao_aprovacao")
  /// PDF do agendamento (SISREG) anexado pelo operador ao aprovar.
  agendamentoPdfUrl      String?   @map("agendamento_pdf_url")
  dataSolicitada         DateTime? @map("data_solicitada")
  dataAgendada           DateTime? @map("data_agendada")
  dataRealizada          DateTime? @map("data_realizada")
  /// true quando o OCR de triagem reprovou a foto do encaminhamento além do
  /// limite de tentativas — sinaliza ao operador revisar a imagem manualmente.
  revisarAnexo           Boolean   @default(false) @map("revisar_anexo")

  // -------- Cancelamento pelo paciente --------
  /// Quando o paciente (solicitante ou paciente cadastrado) cancelou.
  canceladaEm        DateTime? @map("cancelada_em")
  /// Texto livre opcional pra o paciente explicar o motivo.
  motivoCancelamento String?   @map("motivo_cancelamento")

  // -------- Auditoria --------
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")
  enviadoEm    DateTime? @map("enviado_em")

  unidadeSaude      UnidadeSaude? @relation(fields: [unidadeSaudeId], references: [id], onDelete: SetNull)
  especialidade     Especialidade @relation(fields: [especialidadeId], references: [id])
  agenteResponsavel UsuarioCrm?   @relation("SolicitacoesAgenteCrm", fields: [agenteResponsavelCrmId], references: [id])

  anexos       SolicitacaoAnexo[]
  notificacoes Notificacao[]
  conversa     Conversa?

  @@index([solicitanteId])
  @@index([pacienteCpf])
  @@index([unidadeSaudeId])
  @@index([especialidadeId])
  @@index([agenteResponsavelCrmId])
  @@index([status])
  @@index([origem])
  @@index([paraQuem])
  // Fila do Kanban: filtra por status + ordena por criadoEm (FIFO) com paginação.
  @@index([status, criadoEm])
  @@map("solicitacoes")
}

model SolicitacaoAnexo {
  id            String    @id @default(uuid()) @db.Uuid
  solicitacaoId String    @map("solicitacao_id") @db.Uuid
  url           String
  tipo          TipoAnexo
  mimeType      String?   @map("mime_type")
  tamanhoBytes  Int?      @map("tamanho_bytes")
  /// Nullable: anexo de solicitação anônima (WhatsApp) não tem usuário.
  enviadoPorId  String?   @map("enviado_por_id") @db.Uuid
  enviadoEm     DateTime  @default(now()) @map("enviado_em")

  solicitacao Solicitacao   @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  enviadoPor  UsuarioMaria? @relation(fields: [enviadoPorId], references: [id], onDelete: SetNull)

  @@index([solicitacaoId])
  @@index([enviadoPorId])
  @@map("solicitacao_anexos")
}

// ===================================================================
// NOTIFICAÇÕES
// ===================================================================

model Notificacao {
  id             String            @id @default(uuid()) @db.Uuid
  /// Nullable: notificação de solicitação anônima (WhatsApp sem cadastro)
  /// registra só o envio pelo canal — não há inbox in-app pra exibir.
  usuarioMariaId String?           @map("usuario_maria_id") @db.Uuid
  solicitacaoId  String?           @map("solicitacao_id") @db.Uuid
  tipo           TipoNotificacao
  titulo         String?
  corpo          String
  canal          CanalNotificacao
  status         StatusNotificacao @default(PENDENTE)
  mensagemMsgId  String?           @map("mensagem_msg_id")
  enviadoEm      DateTime?         @map("enviado_em")
  lidaEm         DateTime?         @map("lida_em")
  criadoEm       DateTime          @default(now()) @map("criado_em")

  usuarioMaria UsuarioMaria? @relation(fields: [usuarioMariaId], references: [id], onDelete: Cascade)
  solicitacao  Solicitacao?  @relation(fields: [solicitacaoId], references: [id], onDelete: SetNull)

  @@index([usuarioMariaId])
  @@index([solicitacaoId])
  @@index([status])
  @@index([canal])
  @@map("notificacoes")
}

/// Token de push (Expo Push Token) de um aparelho do solicitante.
/// O mesmo token pode trocar de dono (logout/login no aparelho) — o upsert
/// reatribui. `ativo=false` quando o Expo responder DeviceNotRegistered.
model DeviceToken {
  id             String   @id @default(uuid()) @db.Uuid
  usuarioMariaId String   @map("usuario_maria_id") @db.Uuid
  /// ExponentPushToken[...] — identifica o aparelho no Expo Push Service.
  token          String   @unique
  /// 'ios' | 'android' (informativo, vindo do app).
  plataforma     String
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  usuarioMaria UsuarioMaria @relation(fields: [usuarioMariaId], references: [id], onDelete: Cascade)

  @@index([usuarioMariaId])
  @@map("device_tokens")
}

// ===================================================================
// SEGURANÇA / AUDITORIA (CRM)
// ===================================================================

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  usuarioCrmId String    @map("usuario_crm_id") @db.Uuid
  tokenHash    String    @map("token_hash")
  sessionId    String    @map("session_id") @db.Uuid
  expiraEm     DateTime  @map("expira_em")
  revogadoEm   DateTime? @map("revogado_em")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  usuarioCrm UsuarioCrm @relation(fields: [usuarioCrmId], references: [id], onDelete: Cascade)

  @@index([usuarioCrmId])
  @@index([sessionId])
  @@index([revogadoEm])
  @@map("refresh_tokens")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  usuarioCrmId String?  @map("usuario_crm_id") @db.Uuid
  acao         String
  recurso      String
  recursoId    String?  @map("recurso_id")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  metadata     Json?
  criadoEm     DateTime @default(now()) @map("criado_em")

  usuarioCrm UsuarioCrm? @relation(fields: [usuarioCrmId], references: [id], onDelete: SetNull)

  @@index([usuarioCrmId])
  @@index([acao])
  @@index([recurso])
  @@index([criadoEm])
  @@map("audit_logs")
}

// ===================================================================
// ATENDIMENTO — CONVERSA / MENSAGEM
// ===================================================================

/// Sessão de atendimento conduzida pelo motor de fluxo.
/// Fase 0: a definição do fluxo vive em código (TypeScript), então o
/// vínculo é por `fluxoChave` (ex.: "atendimento-v1") + `noAtual` (id do
/// nó no grafo em código) em vez de FK pra tabelas Fluxo* versionadas.
model Conversa {
  id                String         @id @default(uuid()) @db.Uuid
  canal             CanalConversa  @default(WEB)
  /// Nullable: conversa de WhatsApp é anônima (não cria usuário no sistema);
  /// vincula só se o número já pertencer a um UsuarioMaria cadastrado.
  usuarioMariaId    String?        @map("usuario_maria_id") @db.Uuid
  /// Contato externo do canal (telefone E.164 do WhatsApp). É a chave que
  /// localiza a conversa ativa quando não há UsuarioMaria.
  contatoExterno    String?        @map("contato_externo")
  fluxoChave        String         @map("fluxo_chave")
  /// Versão do fluxo (banco) fixada no início da conversa. Null = fluxo hardcoded (fallback).
  fluxoVersaoId     String?        @map("fluxo_versao_id") @db.Uuid
  /// Instância de WhatsApp que recebeu a conversa: respostas (fluxo e gestor)
  /// saem por ela por padrão. Null em conversas legadas / Web/App → usa a padrão.
  instanciaCanalId  String?        @map("instancia_canal_id") @db.Uuid
  noAtual           String?        @map("no_atual")
  estado            EstadoConversa @default(ABERTA)
  /// Snapshot das variáveis já coletadas no fluxo (nome, cpf, especialidade...).
  variaveis         Json           @default("{}")
  solicitacaoId     String?        @unique @map("solicitacao_id") @db.Uuid
  iniciadaEm        DateTime       @default(now()) @map("iniciada_em")
  ultimaInteracaoEm DateTime       @updatedAt @map("ultima_interacao_em")
  encerradaEm       DateTime?      @map("encerrada_em")

  usuarioMaria   UsuarioMaria?   @relation(fields: [usuarioMariaId], references: [id], onDelete: Cascade)
  solicitacao    Solicitacao?    @relation(fields: [solicitacaoId], references: [id], onDelete: SetNull)
  instanciaCanal InstanciaCanal? @relation(fields: [instanciaCanalId], references: [id], onDelete: SetNull)
  mensagens      Mensagem[]

  @@index([usuarioMariaId])
  @@index([contatoExterno])
  @@index([estado])
  @@index([ultimaInteracaoEm])
  @@index([fluxoVersaoId])
  @@index([instanciaCanalId])
  @@map("conversas")
}

/// Cada turno da conversa (entrada do solicitante ou saída do bot/gestor).
model Mensagem {
  id         String          @id @default(uuid()) @db.Uuid
  conversaId String          @map("conversa_id") @db.Uuid
  direcao    DirecaoMensagem
  autor      AutorMensagem
  tipo       TipoMensagem    @default(TEXTO)
  conteudo   String
  anexoUrl   String?         @map("anexo_url")
  /// Id do nó do fluxo (em código) que originou a mensagem — rastreabilidade.
  noFluxo    String?         @map("no_fluxo")
  metadados  Json?
  criadoEm   DateTime        @default(now()) @map("criado_em")

  conversa Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([conversaId])
  @@index([conversaId, criadoEm])
  @@map("mensagens")
}

// ===================================================================
// INTEGRAÇÕES
// ===================================================================

/// Uma instância de canal de WhatsApp. Pode haver VÁRIAS por provedor
/// (vários números Evolution e/ou Meta); `ativo` marca a instância padrão
/// global (exatamente uma true). As credenciais (apiKey/accessToken etc.)
/// ficam num JSON cifrado em `credenciaisCifradas` (AES-256-GCM).
model InstanciaCanal {
  id                   String           @id @default(uuid()) @db.Uuid
  provedor             ProvedorCanal
  /// Apelido exibido nos cards e no seletor de envio (ex.: "SEMUS principal").
  nome                 String
  /// Identificador para casar o webhook de ENTRADA com a instância:
  /// Evolution = nome da instância; Meta = phoneNumberId. Preenchido a partir
  /// das credenciais ao salvar; null até o 1º salvar pós-migração (fallback).
  identificadorExterno String?          @map("identificador_externo")
  credenciaisCifradas  String?          @map("credenciais_cifradas")
  ativo                Boolean          @default(false)
  status               StatusIntegracao @default(DESCONECTADA)
  statusDetalhe        String?          @map("status_detalhe")
  verificadoEm         DateTime?        @map("verificado_em")
  criadoEm             DateTime         @default(now()) @map("criado_em")
  atualizadoEm         DateTime         @updatedAt @map("atualizado_em")

  conversas Conversa[]

  @@unique([provedor, identificadorExterno])
  @@index([provedor])
  @@map("integracoes_canal")
}

// ===================================================================
// FLUXO DE ATENDIMENTO (versionado)
// ===================================================================

/// Agrupa as versões de um fluxo lógico (ex.: "Atendimento").
model FluxoAtendimento {
  id           String    @id @default(uuid()) @db.Uuid
  nome         String
  tipo         TipoFluxo @default(OUTRO)
  descricao    String?
  ativo        Boolean   @default(true)
  /// Posição do card no quadro de fluxos do CRM (compartilhada). Null = auto-layout.
  posicaoX     Int?      @map("posicao_x")
  posicaoY     Int?      @map("posicao_y")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  versoes FluxoVersao[]

  @@map("fluxos_atendimento")
}

/// Uma fotografia (rascunho/publicada) do fluxo. Publicar torna imutável.
model FluxoVersao {
  id                 String            @id @default(uuid()) @db.Uuid
  fluxoAtendimentoId String            @map("fluxo_atendimento_id") @db.Uuid
  numero             Int
  status             StatusFluxoVersao @default(RASCUNHO)
  publicadaEm        DateTime?         @map("publicada_em")
  criadoPorCrmId     String?           @map("criado_por_crm_id") @db.Uuid
  criadoEm           DateTime          @default(now()) @map("criado_em")
  atualizadoEm       DateTime          @updatedAt @map("atualizado_em")

  fluxo     FluxoAtendimento @relation(fields: [fluxoAtendimentoId], references: [id], onDelete: Cascade)
  nos       FluxoNo[]
  arestas   FluxoAresta[]
  variaveis FluxoVariavel[]

  @@unique([fluxoAtendimentoId, numero])
  @@index([fluxoAtendimentoId])
  @@index([status])
  @@map("fluxos_versao")
}

/// Um passo do fluxo. `conteudo` carrega o type-specific (textos, opcoes, etc.).
model FluxoNo {
  id            String      @id @default(uuid()) @db.Uuid
  fluxoVersaoId String      @map("fluxo_versao_id") @db.Uuid
  canal         CanalFluxo  @default(WEB_APP)
  chave         String
  tipo          TipoNoFluxo
  conteudo      Json        @default("{}")
  posicaoX      Int         @default(0) @map("posicao_x")
  posicaoY      Int         @default(0) @map("posicao_y")
  ehInicial     Boolean     @default(false) @map("eh_inicial")
  criadoEm      DateTime    @default(now()) @map("criado_em")
  atualizadoEm  DateTime    @updatedAt @map("atualizado_em")

  versao         FluxoVersao   @relation(fields: [fluxoVersaoId], references: [id], onDelete: Cascade)
  arestasOrigem  FluxoAresta[] @relation("ArestaOrigem")
  arestasDestino FluxoAresta[] @relation("ArestaDestino")

  @@unique([fluxoVersaoId, canal, chave])
  @@index([fluxoVersaoId])
  @@map("fluxos_no")
}

/// Transição entre nós; `condicao` decide quando a aresta é seguida.
model FluxoAresta {
  id            String     @id @default(uuid()) @db.Uuid
  fluxoVersaoId String     @map("fluxo_versao_id") @db.Uuid
  canal         CanalFluxo @default(WEB_APP)
  noOrigemId    String     @map("no_origem_id") @db.Uuid
  noDestinoId   String     @map("no_destino_id") @db.Uuid
  condicao      Json       @default("{}")
  ordem         Int        @default(0)
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  versao    FluxoVersao @relation(fields: [fluxoVersaoId], references: [id], onDelete: Cascade)
  noOrigem  FluxoNo     @relation("ArestaOrigem", fields: [noOrigemId], references: [id], onDelete: Cascade)
  noDestino FluxoNo     @relation("ArestaDestino", fields: [noDestinoId], references: [id], onDelete: Cascade)

  @@index([fluxoVersaoId])
  @@index([noOrigemId])
  @@map("fluxos_aresta")
}

/// Variável que a conversa coleta nesta versão do fluxo.
model FluxoVariavel {
  id            String            @id @default(uuid()) @db.Uuid
  fluxoVersaoId String            @map("fluxo_versao_id") @db.Uuid
  chave         String
  rotulo        String
  tipo          TipoVariavelFluxo @default(TEXTO)
  obrigatoria   Boolean           @default(false)
  criadoEm      DateTime          @default(now()) @map("criado_em")
  atualizadoEm  DateTime          @updatedAt @map("atualizado_em")

  versao FluxoVersao @relation(fields: [fluxoVersaoId], references: [id], onDelete: Cascade)

  @@unique([fluxoVersaoId, chave])
  @@index([fluxoVersaoId])
  @@map("fluxos_variavel")
}
